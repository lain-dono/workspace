    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run",
            "cargo": {
                "args": [
                    "build",
                    "--bin=lifer",
                    "--package=lifer",
                    "--release"
                ],
                "filter": {
                    "name": "lifer",
                    "kind": "bin"
                },
                "cwd": "${workspaceFolder}",
            },
            "cwd": "${workspaceFolder}",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
            }
        }
    ]
}